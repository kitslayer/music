<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Music</string>
	<!-- Siri needs a name it can tell apart. App Shortcut phrases are required to
	     contain the app name, and this app is called "Music", which Siri resolves to
	     Apple Music every time. These are alternates Siri accepts for *this* app; the
	     home screen still says Music. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Navidrome</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>navi drome</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Navi</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Navi Music</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>My Library</string>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0</string>
	<!-- Both are overwritten by CI with the run number and the short commit. The
	     defaults are deliberately "0" and "local": an unstamped build should be
	     recognisable as one, not indistinguishable from a real release. -->
	<key>GitCommit</key>
	<string>local</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Playback must survive the screen locking; without this iOS suspends the
	     app and audio stops. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The server is a plain-HTTP host on the LAN. Allow that specifically
	     rather than disabling App Transport Security wholesale. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- iOS 14+ requires a stated reason before an app may reach LAN addresses. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Music needs your local network to reach your music server.</string>
</dict>
</plist>
